# Public site URL (Square redirects, canonical links)
NEXT_PUBLIC_SITE_URL=https://fieldandfable.ca

# Square (optional; site still books without these)
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_ENVIRONMENT=sandbox
NEXT_PUBLIC_SQUARE_APPLICATION_ID=

# Configurable refundable damage deposit (cents). Default: 25000 = $250
NEXT_PUBLIC_DAMAGE_DEPOSIT_CENTS=25000
